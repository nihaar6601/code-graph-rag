  {
    "question": "How is reserved stock returned when a checkout payment is rejected?",
    "category": "behavior",
    "expected": [
      "shop.service.OrderService.checkout(String,int,int,String,String)",
      "shop.service.PaymentService.charge(int)",
      "shop.service.InventoryService.release(String,int)"
    ],
    "expect_insufficient": false,
    "reference_answer": "When payments.charge fails, checkout calls inventory.release(sku, quantity) before returning PAYMENT_FAILED. release restores positive quantities through stock.restore. charge rejects nonpositive amounts or amounts above 100000 cents.",
    "facts": [
      {
        "id": "q15_f1",
        "description": "Failed charge causes checkout to release reserved stock.",
        "patterns": [
          "\\b(fail\\w*|reject\\w*)\\b.{0,120}\\b(?:inventory\\.release|release\\w* (?:the )?(?:reserved )?stock|restor\\w* (?:the )?(?:reserved )?stock)\\b"
        ],
        "sources": [
          "shop.service.OrderService.checkout(String,int,int,String,String)"
        ]
      },
      {
        "id": "q15_f2",
        "description": "The failed-payment branch returns PAYMENT_FAILED.",
        "patterns": [
          "\\b(return\\w*|result|status)\\b.{0,60}\\bPAYMENT_FAILED\\b"
        ],
        "sources": [
          "shop.service.OrderService.checkout(String,int,int,String,String)"
        ]
      },
      {
        "id": "q15_f3",
        "description": "release restores positive quantities.",
        "patterns": [
          "\\brelease\\b.{0,100}\\b(restor\\w*|stock\\.restore)\\b",
          "\\bpositive\\b.{0,90}\\bstock\\.restore\\b"
        ],
        "sources": [
          "shop.service.InventoryService.release(String,int)"
        ]
      }
    ]
  },
