  {
    "question": "Show only the checkout implementation, without its dependencies.",
    "category": "implementation_only",
    "expected": [
      "shop.service.OrderService.checkout(String,int,int,String,String)"
    ],
    "expect_insufficient": false,
    "reference_answer": "OrderService.checkout rejects negative unit prices or failed reservation with REJECTED. It calculates merchandise plus delivery and charges that amount. A failed charge releases stock and returns PAYMENT_FAILED. Success saves the order, dispatches it, records PLACED, and returns the order ID.",
    "facts": [
      {
        "id": "q06_f1",
        "description": "Negative unit price or failed reservation produces REJECTED.",
        "patterns": [
          "\\b(negative|less than zero|<\\s*0)\\b.{0,120}\\bREJECTED\\b",
          "\\b(reservation fails|failed reservation|cannot reserve|reserve\\([^)]*\\))\\b.{0,100}\\bREJECTED\\b"
        ],
        "sources": [
          "shop.service.OrderService.checkout(String,int,int,String,String)"
        ]
      },
      {
        "id": "q06_f2",
        "description": "The charge combines merchandise and delivery.",
        "patterns": [
          "\\b(merchandise|total)\\b.{0,100}(?:\\+|plus|and|added to).{0,50}\\b(delivery|shipping)\\b"
        ],
        "sources": [
          "shop.service.OrderService.checkout(String,int,int,String,String)"
        ]
      },
      {
        "id": "q06_f3",
        "description": "Failed payment releases reserved inventory and returns PAYMENT_FAILED.",
        "patterns": [
          "\\b(fail\\w*|reject\\w*|unsuccessful)\\b.{0,120}\\b(release\\w*|restor\\w*|return\\w* stock)\\b.{0,120}\\bPAYMENT_FAILED\\b",
          "\\bPAYMENT_FAILED\\b.{0,120}\\b(release\\w*|restor\\w*)\\b"
        ],
        "sources": [
          "shop.service.OrderService.checkout(String,int,int,String,String)"
        ]
      },
      {
        "id": "q06_f4",
        "description": "Successful checkout saves, dispatches and audits the order.",
        "patterns": [
          "\\bsav\\w*\\b.{0,100}\\bdispatch\\w*\\b.{0,100}\\b(audit\\w*|record\\w*|PLACED)\\b"
        ],
        "sources": [
          "shop.service.OrderService.checkout(String,int,int,String,String)"
        ]
      }
    ]
  },
  {
    "question": "Give me just the code for refunding a payment.",
    "category": "implementation_only",
    "expected": [
      "shop.service.PaymentService.refund(int)"
    ],
    "expect_insufficient": false,
    "reference_answer": "PaymentService.refund rejects amounts at or below zero or above chargedCents. Otherwise it subtracts the amount from chargedCents and returns true.",
    "facts": [
      {
        "id": "q07_f1",
        "description": "Refund rejects nonpositive amounts and amounts above the balance.",
        "patterns": [
          "\\b(reject\\w*|false)\\b.{0,120}\\b(nonpositive|non-positive|<=\\s*0|zero or negative)\\b.{0,120}\\b(balance|chargedCents)\\b",
          "amountCents\\s*<=\\s*0\\s*\\|\\|\\s*amountCents\\s*>\\s*chargedCents",
          "\\brefund\\b.{0,100}\\b(reject\\w*|false)\\b.{0,80}\\b(at or below zero|zero or negative|nonpositive|non-positive)\\b.{0,100}\\b(above|exceed\\w*|greater than)\\b.{0,60}\\b(chargedCents|balance)\\b"
        ],
        "sources": [
          "shop.service.PaymentService.refund(int)"
        ]
      },
      {
        "id": "q07_f2",
        "description": "Accepted refunds subtract from chargedCents.",
        "patterns": [
          "chargedCents\\s*-=\\s*amountCents",
          "\\b(subtract\\w*|reduc\\w*|deduct\\w*)\\b.{0,90}\\b(balance|chargedCents)\\b"
        ],
        "sources": [
          "shop.service.PaymentService.refund(int)"
        ]
      }
    ]
  },
